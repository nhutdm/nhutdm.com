---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" noindex>
  <div class="nf">
    <p class="nf-kicker mono-label" data-animate style="--i: 0">Not Found</p>
    <h1 class="nf-title" data-animate style="--i: 1">
      404<span class="dot">&period;</span>
    </h1>
    <div class="nf-rule" data-animate style="--i: 2"></div>
    <p class="nf-voice" data-animate style="--i: 3">No ink on this page.</p>
    <a class="nf-back mono-label" href="/" data-animate style="--i: 4"
      >nhutdm.com &rarr;</a
    >
  </div>
</BaseLayout>
