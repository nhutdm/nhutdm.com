---
import { Font } from "astro:assets";
import siteConfig from "@/data/site-config";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = siteConfig.description,
  noindex = false,
  jsonLd,
} = Astro.props;
const fullTitle = `${siteConfig.title} ${siteConfig.titleSeparator} ${title}`;
const ogImage = siteConfig.image?.src
  ? new URL(siteConfig.image.src, siteConfig.siteUrl).toString()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="generator" content={Astro.generator}>
    <title>{fullTitle}</title>
    <link rel="canonical" href={siteConfig.siteUrl}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={siteConfig.siteUrl}>
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {siteConfig.image?.alt && (
      <meta property="og:image:alt" content={siteConfig.image.alt} />
    )}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content={siteConfig.twitter}>
    <meta name="twitter:creator" content={siteConfig.twitter}>
    <meta name="twitter:title" content={fullTitle}>
    <meta name="twitter:description" content={description}>
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-source-serif" preload />
    <Font cssVariable="--font-ibm-plex-mono" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="bg-background min-h-dvh antialiased">
    <main class="card-stage">
      <slot />
    </main>
  </body>
</html>
